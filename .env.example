# ─────────────────────────────────────────────────────────────────────────────
#  Bangladesh Legal Aid Chatbot — configuration
#  Copy to .env (local) or put the same keys in .streamlit/secrets.toml
#  (Streamlit Cloud). Environment variables win over secrets.
# ─────────────────────────────────────────────────────────────────────────────

# ── Groq (LLM + Whisper speech-to-text) ─────────────────────────────────────
# Free key: https://console.groq.com/keys . Leave empty to let each visitor
# paste their own key in the sidebar (kept only in their browser session).
GROQ_API_KEY=
# Default model and the list shown in the sidebar (comma separated).
# LLM_MODELS is also the FAILOVER ORDER: if the selected model is rate-limited,
# down or retired, the next one answers. Put a single model to disable failover.
# NOTE: llama-3.1-8b-instant / llama-3.3-70b-versatile were shut down for
# free/dev tiers on 2026-08-16 — do not use them.
GROQ_MODEL=openai/gpt-oss-120b
LLM_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2048
LLM_REASONING_EFFORT=low
TRANSCRIPTION_MODEL=whisper-large-v3-turbo

# ── Embeddings & reranking (run locally, downloaded once) ───────────────────
EMBEDDING_BACKEND=fastembed
EMBEDDING_MODEL=intfloat/multilingual-e5-base
# Low-memory option (e.g. Streamlit Community Cloud): intfloat/multilingual-e5-small
# Leave RERANKER_MODEL empty to disable reranking (saves ~600 MB RAM).
RERANKER_MODEL=BAAI/bge-reranker-v2-m3-int8
MODEL_CACHE_DIR=./.cache/models

# ── Vector store ────────────────────────────────────────────────────────────
# local = embedded ChromaDB on disk | http = your own Chroma server | cloud = Chroma Cloud
CHROMA_MODE=local
CHROMA_DIR=./vectorstore/chroma_db
COLLECTION_NAME=bangladesh_law
# CHROMA_HOST=
# CHROMA_PORT=8000
# CHROMA_SSL=false
# CHROMA_API_KEY=
# CHROMA_TENANT=
# CHROMA_DATABASE=

# ── Ingestion ───────────────────────────────────────────────────────────────
PDF_DIR=./data
CHUNK_SIZE=1200
CHUNK_OVERLAP=150
# Tesseract languages for scanned PDFs ("ben" needs the Bengali language pack)
OCR_LANG=eng+ben
OCR_CACHE_DIR=./.cache/ocr
OCR_WORKERS=0
# Index PDFs whose printed title contradicts the file name (default: refuse)
ALLOW_SUSPICIOUS_DOCS=false
# Windows only, if tesseract.exe is not on PATH:
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# ── Retrieval / chat ────────────────────────────────────────────────────────
TOP_K=5
CANDIDATE_K=20
HISTORY_TURNS=4

# ── Abuse protection / voice ────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=8
MAX_AUDIO_MB=20
