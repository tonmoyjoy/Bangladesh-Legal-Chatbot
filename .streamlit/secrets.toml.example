# Streamlit Community Cloud → App settings → Secrets. Same keys as .env.example.
GROQ_API_KEY = "gsk_..."
GROQ_MODEL = "openai/gpt-oss-120b"

# The index committed in vectorstore/chroma_db was built with this model
# (multilingual: Bangla + English, small enough for Streamlit Cloud).
EMBEDDING_BACKEND = "fastembed"
EMBEDDING_MODEL = "intfloat/multilingual-e5-small"
RERANKER_MODEL = ""

# Uses the committed index. To use Chroma Cloud instead, set CHROMA_MODE = "cloud"
# plus CHROMA_API_KEY / CHROMA_TENANT / CHROMA_DATABASE, and build the cloud index
# with the same EMBEDDING_MODEL: python ingest.py --rebuild
CHROMA_MODE = "local"
