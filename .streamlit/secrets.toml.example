# Streamlit Community Cloud → App settings → Secrets. Same keys as .env.example.
GROQ_API_KEY = "gsk_..."
GROQ_MODEL = "openai/gpt-oss-120b"
# FastEmbed supports this legacy index model and avoids PyTorch dependencies.
EMBEDDING_BACKEND = "fastembed"
EMBEDDING_MODEL = "sentence-transformers/all-MiniLM-L6-v2"
RERANKER_MODEL = ""
CHROMA_MODE = "cloud"
CHROMA_API_KEY = "ck-..."
CHROMA_TENANT = "..."
CHROMA_DATABASE = "bangladesh-law"
